{
  "name": "vetai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "demo": "wrangler dev --config wrangler.demo.toml --local --port 8790",
    "dev": "wrangler dev",
    "live-demo": "wrangler dev --config wrangler.live-ai.toml --env live-ai --local --port 8791",
    "test": "vitest run",
    "eval:openai": "node --env-file=.dev.vars.live-ai node_modules/vitest/vitest.mjs run test/liveOpenAiEval.test.ts",
    "eval:openai-multiturn": "node --env-file=.dev.vars.live-ai node_modules/vitest/vitest.mjs run test/liveOpenAiMultiTurnEval.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
